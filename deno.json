{
  "lock": false,
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env server/main.ts",
    "dev": "deno run --watch --allow-net --allow-read --allow-env server/main.ts",
    "test": "deno test --allow-net --allow-read --allow-env"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  },
  "fmt": {
    "include": ["server/", "api/", "deno.json"]
  },
  "lint": {
    "include": ["server/", "api/"]
  }
}
